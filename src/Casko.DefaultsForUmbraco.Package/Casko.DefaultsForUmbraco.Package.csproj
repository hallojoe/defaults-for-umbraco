<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <PropertyGroup>
    <Product>Casko.DefaultsForUmbraco</Product>
    <PackageId>Casko.DefaultsForUmbraco</PackageId>
    <Title>Defaults for Umbraco</Title>
    <Authors>Casper Korsgaard</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Casper Korsgaard</Copyright>
    <PackageProjectUrl>https://github.com/hallojoe/defaults-for-umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hallojoe/defaults-for-umbraco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>  
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Search.Core" />
    <PackageReference Include="Umbraco.Cms.Search.BackOffice" />
    <PackageReference Include="Umbraco.Cms.Search.DeliveryApi" />
    <PackageReference Include="Umbraco.Cms.Search.Provider.Examine" />
      
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.AI.Core" />
    <PackageReference Include="Umbraco.AI.OpenAI" />
    <PackageReference Include="Umbraco.AI.Prompt" />
    <PackageReference Include="Umbraco.AI.Agent" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" />

    <PackageReference Include="Umbraco.Automate" />
    <PackageReference Include="Umbraco.AI.Automate" />

    <PackageReference Include="Casko.XmlSitemapsForUmbraco" />
    <PackageReference Include="Casko.HttpHeadersForUmbraco" />
    <PackageReference Include="Casko.RobotsTxtForUmbraco" />
      
  </ItemGroup>
</Project>
