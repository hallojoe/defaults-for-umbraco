{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "cm": {
        "ClusterId": "cm",
        "Match": {
          "Hosts": [
            "cm.dev.localhost"
          ],
          "Path": "{**catch-all}"
        }
      },
      "cd": {
        "ClusterId": "cd",
        "Match": {
          "Hosts": [
            "cd.dev.localhost"
          ],
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cm": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:64101/"
          }
        }
      },
      "cd": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      }
    }
  }
}
