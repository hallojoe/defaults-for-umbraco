{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "saml": {
        "ClusterId": "saml",
        "Match": {
          "Hosts": [
            "samlcasko0001.dev.localhost"
          ],
          "Path": "{**catch-all}"
        }
      },
      "cm": {
        "ClusterId": "cm",
        "Match": {
          "Hosts": [
            "cm.dev.localhost"
          ],
          "Path": "{**catch-all}"
        }
      },
      "cd": {
        "ClusterId": "cd",
        "Match": {
          "Hosts": [
            "cd.dev.localhost",
            "cd1.dev.localhost",
            "cd2.dev.localhost",
            "cd3.dev.localhost",
            "cd4.dev.localhost",
            "cd5.dev.localhost"
          ],
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "saml": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      },
      "cm": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:64101/"
          }
        }
      },
      "cd": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      },
      "cd1": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      },
      "cd2": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      },
      "cd3": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      },
      "cd4": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      },
      "cd5": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44101/"
          }
        }
      }

    }
  }
}
