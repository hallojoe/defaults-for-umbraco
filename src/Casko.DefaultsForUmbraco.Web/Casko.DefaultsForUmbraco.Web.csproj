<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Casko.DefaultsForUmbraco.Web.UI" />
    </ItemGroup>
    
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
        <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
        <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
        <PackageReference Include="Azure.Storage.Blobs" />
        <PackageReference Include="Umbraco.Cms"/>
        <PackageReference Include="Umbraco.Cms.Core" />
        <PackageReference Include="Umbraco.Cms.Infrastructure" />
        <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice"/>
        <PackageReference Include="Umbraco.StorageProviders.AzureBlob" />
        <PackageReference Include="Umbraco.StorageProviders.AzureBlob.ImageSharp" />
        <PackageReference Include="uSync" />
        <PackageReference Include="uSync.Command.Setup" />
        <PackageReference Include="Casko.XmlSitemapsForUmbraco" />
        <PackageReference Include="Casko.RobotsTxtForUmbraco" />
        <PackageReference Include="Casko.HttpHeadersForUmbraco" />
        <PackageReference Include="Casko.Nemlogin3ForUmbraco" />
        <PackageReference Include="Casko.OpenTelemetry.Extensions.AspNetCore" />
        <PackageReference Include="Casko.OpenTelemetry.Extensions.SeriLog" />
        <PackageReference Include="Casko.SyncExtensionsForUmbraco" />
    </ItemGroup>
    
    <ItemGroup>
      <None Update="appsettings-schema.Umbraco.Cms.json">
        <DependentUpon>appsettings-schema.json</DependentUpon>
      </None>
      <None Update="appsettings-schema.Umbraco.StorageProviders.json">
        <DependentUpon>appsettings-schema.json</DependentUpon>
      </None>
      <None Update="appsettings-schema.Umbraco.StorageProviders.AzureBlob.json">
        <DependentUpon>appsettings-schema.json</DependentUpon>
      </None>
      <None Update="appsettings-schema.usync.json">
        <DependentUpon>appsettings-schema.json</DependentUpon>
      </None>
      <None Update="umbraco-package-schema.json">
        <DependentUpon>appsettings-schema.json</DependentUpon>
      </None>
    </ItemGroup>
    
</Project>
