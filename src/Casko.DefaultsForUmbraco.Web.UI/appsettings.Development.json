{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "__uSync": {
    "Settings": {
      "ImportAtStartup": "None"
    },
    "Command": {
      "AddIfMissing": true,
      "ClientId": "umbraco-back-office-usync",
      "Secret": "1234567890"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "RobotsTxt": {
    "Enabled": true,
    "RewritesEnabled": true,
    "DefaultHost": "",
    "Hosts": {
      "": {
        "Host": "",
        "Include": ["robots.txt"]
      },
      "cd": {
        "Host": "cd.dev.localhost:4443",
        "Sitemaps": ["xmlsitemap.xml"],
        "Include": ["robots.defaults.txt", "robots.cultures.txt", "robots.ai-bots.txt"]
      },
      "cd1": {
        "Host": "cd1.dev.localhost:4443",
        "Sitemaps": ["xmlsitemap.xml"],
        "Include": ["robots.ai-bots.txt", "robots.defaults.txt", "robots.defaults.txt", "robots.cultures.txt"]
      }
    },
    "Storage": {
      "RefreshStaleAfterSeconds": 3600,
      "BackgroundJob": {
        "Enabled": true,
        "IntervalSeconds": 3600,
        "RefreshJobDelayInSeconds": 30
      },
      "Media": {
        "FolderName":"robots.txt",
        "__MediaTypeAlias": "robotsTxtFile",
        "__MediaTypePropertyAlias": "robotsTxt"
      }
    }
  },
  "Umbraco": {
    "Storage": {
      "AzureBlob": {
        "Media": {
          "ConnectionString": "UseDevelopmentStorage=true",
          "ContainerName": "media"
        }
      }
    },
    "CMS": {
      "DeliveryApi": {
        "PublicAccess": true
      },
      "Hosting": {
        "Debug": true
      },
      "Runtime": {
        "Mode": "BackOfficeDevelopment"
      },
      "Logging": {
        "MaxLogAge": "2.00:00:00",
        "FileNameFormat": "UmbracoTraceLog.{0}.json",
        "FileNameFormatArguments": "MachineName",
        "SessionIdLogging": "SessionId"
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "Unattended": {
        "InstallUnattended": true,
        "PackageMigrationsUnattended": true,
        "UpgradeUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890",
        "UnattendedTelemetryLevel": "Minimal"
      },
      "InstallDefaultData": {
        "Languages": {
          "InstallData": "Values",
          "Values": [
            "da",
            "en",
            "pl"
          ]
        }
        }
    }
  }
}
