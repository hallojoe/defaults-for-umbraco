# Build-time Delivery API configuration. Do not expose these through PUBLIC_ variables.
UMBRACO_DELIVERY_API_URL=https://cd.dev.localhost:4443
UMBRACO_DELIVERY_START_ITEM=b04a32de-a3c4-4946-9ce4-efb9bbedb396
# UMBRACO_DELIVERY_API_KEY=

# Public origin for relative media URLs returned in rich text and media picker values.
# Locally this defaults to the Delivery API origin. In production set this to the
# public Umbraco media/CDN origin, for example https://media.example.com.
# UMBRACO_MEDIA_BASE_URL=https://media.example.com
