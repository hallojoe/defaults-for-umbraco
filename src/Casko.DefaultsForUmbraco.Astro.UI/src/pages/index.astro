---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDeliverySite, getRootPages } from '../lib/delivery-api';

const site = await getDeliverySite();
const rootPages = getRootPages(site);
const page = rootPages.find((item) => item.culture === 'da');

if (!page) {
  throw new Error('The Delivery API root did not provide a Danish home page.');
}

const primaryNavigation = site.pages.filter((item) => item.culture === page.culture && item.kind === 'list');
---

<SiteLayout {page} {primaryNavigation} languageNavigation={rootPages} breadcrumbs={[]}>
  <main>
    <h1>{page.title}</h1>
    {page.description && <p>{page.description}</p>}
    {page.contentMarkup && <div set:html={page.contentMarkup} />}
  </main>
</SiteLayout>
