---
import PageRenderer from '../components/PageRenderer.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBreadcrumbs, getDeliverySite, getRootPages, type SitePage } from '../lib/delivery-api';

export async function getStaticPaths() {
  const site = await getDeliverySite();
  const rootPages = getRootPages(site);
  return site.pages.filter((page) => page.kind !== 'home' || page.culture !== 'da').map((page) => ({ params: { slug: page.routePath.split('/').filter(Boolean).join('/') }, props: { page, pages: site.pages, rootPages } }));
}

interface Props { page: SitePage; pages: SitePage[]; rootPages: SitePage[]; }
const { page, pages, rootPages } = Astro.props;
const primaryNavigation = pages.filter((item) => item.culture === page.culture && item.kind === 'area');
const breadcrumbs = getBreadcrumbs(page, pages);
---
<SiteLayout {page} {primaryNavigation} languageNavigation={rootPages} {breadcrumbs}><PageRenderer {page} {pages} /></SiteLayout>
