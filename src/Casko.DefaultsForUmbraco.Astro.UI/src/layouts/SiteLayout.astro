---
import type { SitePage } from '../lib/delivery-api';

interface Props {
  page: SitePage;
  primaryNavigation: SitePage[];
  languageNavigation: SitePage[];
  breadcrumbs: SitePage[];
}

const { page, primaryNavigation, languageNavigation, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang={page.culture}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.description ?? page.title} />
    <title>{page.title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href={languageNavigation.find((item) => item.culture === page.culture)?.routePath ?? '/'}>Casko</a>
      <nav aria-label="Primary navigation">
        <ul>
          {primaryNavigation.map((item) => (
            <li><a href={item.routePath} aria-current={item.routePath === page.routePath ? 'page' : undefined}>{item.title}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Language navigation">
        <ul>
          {languageNavigation.map((item) => (
            <li><a href={item.routePath} hreflang={item.culture} aria-current={item.culture === page.culture ? 'page' : undefined}>{item.culture.toUpperCase()}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    {page.kind !== 'home' && (
      <nav aria-label="Breadcrumb">
        <ol>
          {breadcrumbs.map((item, index) => (
            <li>{index === breadcrumbs.length - 1 ? item.title : <a href={item.routePath}>{item.title}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
    <footer>© 2026 Casko</footer>
  </body>
</html>

<style>
  :global(body) { font-family: system-ui, sans-serif; line-height: 1.5; margin: 0 auto; max-width: 72rem; padding: 1.5rem; }
  header { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
  .brand { font-size: 1.25rem; font-weight: 700; }
  ul, ol { display: flex; flex-wrap: wrap; gap: 0.75rem; padding-left: 1.25rem; }
  footer { border-top: 1px solid #ccc; margin-top: 3rem; padding-top: 1rem; }
</style>
