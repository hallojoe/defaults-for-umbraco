---
import type { SitePage } from '../lib/delivery-api';

interface Props { page: SitePage; pages: SitePage[]; }
const { page, pages } = Astro.props;
const children = pages.filter((candidate) => candidate.culture === page.culture && candidate.parentPath === page.routePath);
const groupChildren = children.filter((child) => ['text', 'event', 'product'].includes(child.kind));
const tagResults = pages.filter((candidate) => candidate.culture === page.culture && ['text', 'event', 'product'].includes(candidate.kind));
const formatDate = (value: string) => new Intl.DateTimeFormat(page.culture, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
---

{page.kind === 'home' && <section class="hero"><p class="eyebrow">Welcome</p><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}{page.contentMarkup && <div class="prose" set:html={page.contentMarkup} />}</section>}

{page.kind === 'area' && <section><header class="page-header"><p class="eyebrow">Area</p><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}{page.contentMarkup && <div class="prose" set:html={page.contentMarkup} />}</header><div class="card-grid">{children.filter((child) => child.kind === 'group').map((child) => <article class="card"><p class="eyebrow">Group</p><h2><a href={child.routePath}>{child.title}</a></h2>{child.description && <p>{child.description}</p>}<a class="text-link" href={child.routePath}>Explore group <span aria-hidden="true">→</span></a></article>)}</div></section>}

{page.kind === 'group' && <section><header class="page-header"><p class="eyebrow">Group</p><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}{page.contentMarkup && <div class="prose" set:html={page.contentMarkup} />}</header><div class="card-grid">{groupChildren.map((child) => <article class="card"><p class="eyebrow">{child.kind}</p><h2><a href={child.routePath}>{child.kind === 'product' ? (child.productName ?? child.title) : child.title}</a></h2>{child.description && <p>{child.description}</p>}{child.kind === 'event' && (child.eventStartDate || child.eventEndDate) && <p class="card-meta">{child.eventStartDate && formatDate(child.eventStartDate)}{child.eventStartDate && child.eventEndDate && ' – '}{child.eventEndDate && formatDate(child.eventEndDate)}</p>}{child.kind === 'product' && <>{child.productImageUrl && <img class="card-image" src={child.productImageUrl} alt={child.productImageAlt ?? child.productName ?? ''} loading="lazy" />}{child.productSku && <p class="card-meta">SKU: {child.productSku}</p>}</>}<a class="text-link" href={child.routePath}>Read more <span aria-hidden="true">→</span></a></article>)}</div></section>}

{page.kind === 'text' && <article class="article"><header class="page-header"><p class="eyebrow">Article</p><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}</header>{page.contentMarkup && <div class="prose" set:html={page.contentMarkup} />}{page.tags.length > 0 && <p class="tag-list">{page.tags.map((tag) => <span>{tag}</span>)}</p>}</article>}

{page.kind === 'event' && <article class="article"><header class="page-header"><p class="eyebrow">Event</p><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}</header>{(page.eventStartDate || page.eventEndDate) && <dl class="details">{page.eventStartDate && <><dt>Starts</dt><dd>{formatDate(page.eventStartDate)}</dd></>}{page.eventEndDate && <><dt>Ends</dt><dd>{formatDate(page.eventEndDate)}</dd></>}</dl>}{page.contentMarkup && <div class="prose" set:html={page.contentMarkup} />}{(page.contactEmail || page.contactTelephone) && <section class="contact"><h2>Contact</h2>{page.contactEmail && <p><a href={`mailto:${page.contactEmail}`}>{page.contactEmail}</a></p>}{page.contactTelephone && <p><a href={`tel:${page.contactTelephone}`}>{page.contactTelephone}</a></p>}</section>}{page.tags.length > 0 && <p class="tag-list">{page.tags.map((tag) => <span>{tag}</span>)}</p>}</article>}

{page.kind === 'product' && <article class="article product"><header class="page-header"><p class="eyebrow">Product</p><h1>{page.productName ?? page.title}</h1></header>{page.productImageUrl && <img class="product-image" src={page.productImageUrl} alt={page.productImageAlt ?? page.productName ?? ''} loading="lazy" />}{page.productDescriptionMarkup && <div class="prose" set:html={page.productDescriptionMarkup} />}{(page.productSku || page.productBrand || page.productCategory) && <dl class="details">{page.productSku && <><dt>SKU</dt><dd>{page.productSku}</dd></>}{page.productBrand && <><dt>Brand</dt><dd>{page.productBrand}</dd></>}{page.productCategory && <><dt>Category</dt><dd>{page.productCategory}</dd></>}</dl>}{page.tags.length > 0 && <p class="tag-list">{page.tags.map((tag) => <span>{tag}</span>)}</p>}</article>}

{page.kind === 'tags' && <section class="tag-explorer" data-tag-explorer><header class="page-header"><p class="eyebrow">Explore</p><h1>{page.title}</h1><p class="lede">Browse published articles, events, and products by topic.</p></header><nav class="tag-list" aria-label="Tags">{[...new Set(tagResults.flatMap((item) => item.tags))].sort().map((tag) => <a href={`${page.routePath}?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</nav><p class="tag-status" aria-live="polite">Choose a tag to see related content.</p><div class="tag-results">{tagResults.map((item) => <article class="card" data-tags={item.tags.map((tag) => tag.toLocaleLowerCase()).join('|')} hidden><h2><a href={item.routePath}>{item.kind === 'product' ? (item.productName ?? item.title) : item.title}</a></h2>{item.description && <p>{item.description}</p>}</article>)}</div><script is:inline>document.querySelectorAll('[data-tag-explorer]').forEach((root) => { const selected = new URLSearchParams(window.location.search).get('tag'); const status = root.querySelector('.tag-status'); const cards = [...root.querySelectorAll('[data-tags]')]; if (!selected) return; const needle = selected.toLocaleLowerCase(); let count = 0; cards.forEach((card) => { const match = card.dataset.tags.split('|').includes(needle) && count < 50; card.hidden = !match; if (match) count += 1; }); status.textContent = count ? count + ' result' + (count === 1 ? '' : 's') + ' for “' + selected + '”.' : 'No published content found for “' + selected + '”.'; root.querySelectorAll('.tag-list a').forEach((link) => { if (new URL(link.href).searchParams.get('tag')?.toLocaleLowerCase() === needle) link.setAttribute('aria-current', 'page'); }); });</script></section>}

{page.kind === 'search' && <section class="search-page"><header class="page-header"><p class="eyebrow">Search</p><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}</header><form class="search-form" data-fake-search><label for="site-search">Search the site</label><div><input id="site-search" name="q" type="search" placeholder="Search the site" /><button type="submit">Search</button></div><p role="status" aria-live="polite"></p></form><script is:inline>document.querySelectorAll('[data-fake-search]').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); form.querySelector('[role=status]').textContent = 'Search is not available in this static demonstration.'; }));</script></section>}

{page.kind === 'generic' && <article class="article"><header class="page-header"><h1>{page.title}</h1>{page.description && <p class="lede">{page.description}</p>}</header>{page.contentMarkup && <div class="prose" set:html={page.contentMarkup} />}</article>}
