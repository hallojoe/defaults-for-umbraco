    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Umbraco.Cms" Version="17.6.2" />
    <!-- Keep the Umbraco.Cms package family on one patch version. Core loads related assemblies by exact version. -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Api.Delivery" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Web" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Tests.Integration" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.Search.Core" Version="17.1.0" />
    <PackageVersion Include="Umbraco.Cms.Search.BackOffice" Version="17.1.0" />
    <PackageVersion Include="Umbraco.Cms.Search.DeliveryApi" Version="17.1.0" />
    <PackageVersion Include="Umbraco.Cms.Search.Provider.Examine" Version="17.1.0-beta.1" />
    <PackageVersion Include="Umbraco.Automate" Version="17.2.0" />
    <PackageVersion Include="Umbraco.AI" Version="17.1.1" />
    <PackageVersion Include="Umbraco.AI.Core" Version="17.1.1" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="17.1.4" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot" Version="17.0.4" />
    <PackageVersion Include="Umbraco.AI.Prompt" Version="17.2.3" />
    <PackageVersion Include="Umbraco.AI.OpenAI" Version="17.2.0" />
    <PackageVersion Include="Umbraco.AI.Automate" Version="17.0.0" />
    <PackageVersion Include="Umbraco.AI.Search" Version="17.0.3" />
    <PackageVersion Include="uSync" Version="17.3.6" />
    <PackageVersion Include="Casko.HttpHeadersForUmbraco" Version="1.0.3-pre" />
    <PackageVersion Include="Casko.XmlSitemapsForUmbraco" Version="2.3.4-pre" />
    <PackageVersion Include="Casko.RobotsTxtForUmbraco" Version="1.0.1-pre" />
