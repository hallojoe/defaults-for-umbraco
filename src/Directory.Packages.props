    <PackageVersion Include="ITfoxtec.Identity.Saml2" Version="4.20.1" />
    <PackageVersion Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.20.1" />
    <PackageVersion Include="BuildBundlerMinifier" Version="3.2.449" />
      
  </ItemGroup>
</Project>
